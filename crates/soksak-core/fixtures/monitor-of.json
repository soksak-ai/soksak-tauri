{
  "note": "창 소속 모니터 판정의 오라클. 두 구현(soksak-core geometry, electron/native/window.cjs)이 같은 답을 내는지 이 파일 하나로 묶는다 — 한쪽만 고치면 그쪽 검사가 깨진다.",
  "cases": [
    {
      "why": "중심이 왼쪽 모니터 안",
      "window": { "x": 100, "y": 100, "w": 800, "h": 600 },
      "monitors": [{ "x": 0, "y": 0, "w": 1920, "h": 1080 }, { "x": 1920, "y": 0, "w": 2560, "h": 1440 }],
      "monitor": 0
    },
    {
      "why": "중심이 오른쪽 모니터 안",
      "window": { "x": 2000, "y": 200, "w": 800, "h": 600 },
      "monitors": [{ "x": 0, "y": 0, "w": 1920, "h": 1080 }, { "x": 1920, "y": 0, "w": 2560, "h": 1440 }],
      "monitor": 1
    },
    {
      "why": "경계를 걸친 창도 하나로 — 중심이 정확히 경계면 오른쪽(왼쪽 경계는 안, 오른쪽 경계는 밖)",
      "window": { "x": 1520, "y": 0, "w": 800, "h": 600 },
      "monitors": [{ "x": 0, "y": 0, "w": 1920, "h": 1080 }, { "x": 1920, "y": 0, "w": 2560, "h": 1440 }],
      "monitor": 1
    },
    {
      "why": "화면 밖 창은 없음 — 0 으로 떨어뜨리면 '첫 모니터에 있다'와 구분되지 않는다",
      "window": { "x": -5000, "y": -5000, "w": 100, "h": 100 },
      "monitors": [{ "x": 0, "y": 0, "w": 1920, "h": 1080 }],
      "monitor": null
    },
    {
      "why": "모니터가 하나도 없으면 없음",
      "window": { "x": 0, "y": 0, "w": 10, "h": 10 },
      "monitors": [],
      "monitor": null
    },
    {
      "why": "중심 계산의 나머지 버림 방향까지 같아야 한다(홀수 크기)",
      "window": { "x": 10, "y": 20, "w": 5, "h": 7 },
      "monitors": [{ "x": 12, "y": 23, "w": 1, "h": 1 }],
      "monitor": 0
    }
  ]
}
