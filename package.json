{
  "name": "soksak",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/framework-required.mjs dev",
    "dev:tauri": "pnpm build:cored && SOKSAK_FRAMEWORK=tauri vite",
    "dev:electron": "SOKSAK_FRAMEWORK=electron vite",
    "build:platform": "pnpm --filter @soksak-ai/plugin-spec build && pnpm --filter @soksak-ai/plugin-api build",
    "prebuild": "pnpm run build:platform",
    "build": "tsc && SOKSAK_FRAMEWORK=tauri vite build && SOKSAK_FRAMEWORK=electron vite build",
    "typecheck": "tsc --noEmit",
    "build:tauri": "pnpm stage:cored && pnpm run build:platform && tsc && SOKSAK_FRAMEWORK=tauri vite build",
    "build:electron": "pnpm run build:platform && tsc && SOKSAK_FRAMEWORK=electron vite build",
    "check:framework-artifacts": "node scripts/gates/framework-artifact-isolation.mjs",
    "preview": "node scripts/framework-required.mjs preview",
    "preview:tauri": "SOKSAK_FRAMEWORK=tauri vite preview",
    "preview:electron": "SOKSAK_FRAMEWORK=electron vite preview",
    "pretest": "pnpm run build:platform",
    "test": "pnpm run build:cored && pnpm run test:vitest run --exclude scripts/electron/content-view-live.test.mjs && pnpm run test:vitest run scripts/electron/content-view-live.test.mjs",
    "test:vitest": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "tauri": "tauri",
    "build:cored": "node scripts/build/prepare-cored-sidecar.mjs --build-only",
    "stage:cored": "node scripts/build/prepare-cored-sidecar.mjs --stage",
    "icons:extract": "node scripts/icons/extract.mjs",
    "check:utterances": "node scripts/e2e/check-utterances.mjs"
  },
  "dependencies": {
    "@soksak-ai/plugin-api": "workspace:*",
    "@soksak-ai/plugin-spec": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tabler/icons": "^3.44.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.2.0",
    "jsdom": "^29.1.1",
    "lucide-static": "^1.17.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  }
}
